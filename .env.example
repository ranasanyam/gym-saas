# ──────────────────────────────────────────────────────────
# GymStack — Environment Variables
# Copy this file to .env.local for local development.
# Set these in Vercel dashboard per environment (dev / prod).
# ──────────────────────────────────────────────────────────

# ── DATABASE (required) ───────────────────────────────────
# Use a separate DB or schema per environment.
# Neon/Supabase: create two projects (gymstack-dev, gymstack-prod)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/gymstack?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/gymstack?sslmode=require"

# ── AUTH (required) ───────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Dev:  http://localhost:3000
# Prod: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ── JWT (required for mobile auth) ───────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-min-16-chars"
JWT_REFRESH_SECRET="your-refresh-secret-min-16-chars"

# ── GOOGLE OAUTH (optional) ───────────────────────────────
# Separate OAuth apps recommended for dev/prod
# (different Authorized redirect URIs per environment)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── CLOUDINARY (optional) ─────────────────────────────────
# Can share one account across envs — uploads go to separate folders
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── RAZORPAY (required for payments) ─────────────────────
# Use Razorpay TEST keys for dev, LIVE keys for prod
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── EMAIL (optional) ──────────────────────────────────────
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_FROM_ADDRESS="noreply@gymstack.app"
EMAIL_FROM_NAME="GymStack"

# ── WEB PUSH / VAPID (optional) ───────────────────────────
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="admin@gymstack.app"

# ── AI (optional) ─────────────────────────────────────────
GROQ_API_KEY=""

# ── APP URL (used in server-side links) ──────────────────
# Dev:  http://localhost:3000
# Prod: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"
